# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - PROMPTTOSITE
# Sao chép file này thành .env.local để chạy cục bộ
# ==============================================================================

# 1. Cơ sở dữ liệu PostgreSQL (Supabase / Neon) - Nếu bỏ trống, hệ thống tự dùng ./data/*.json
DATABASE_URL="postgresql://user:password@localhost:5432/prompttosite?schema=public"

# 2. Xác thực & Chế độ Demo (A2)
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-ky-tu"
DEMO_MODE="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 3. Khóa mã hóa AES-256-GCM 32 byte dạng base64 (A4)
# Sinh bằng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# 4. Cấu hình AI LLM (Tùy chọn - có thể nhập qua BYOK trong Studio)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# 5. Telegram Bot mặc định & Email thông báo Resend (A4, C3)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="PromptToSite <onboarding@resend.dev>"

# 6. Giới hạn tần suất Upstash Redis (Tùy chọn - tự động fallback bộ nhớ nếu trống) (A5)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 7. Thanh toán PayOS (D3)
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# 8. URL công khai của ứng dụng
NEXT_PUBLIC_APP_URL="http://localhost:3000"
